# Получите токен у @BotFather. Не отправляйте его в чат и не коммитьте .env.
BOT_TOKEN=
ADMIN_TELEGRAM_ID=
RETENTION_DAYS=7
SITE_LIMIT=500
CONNECTIONS=8
MAX_PROCESSES=2
PROCESS_MEMORY_MB=768
REQUEST_TIMEOUT=12
ENGINE_TIMEOUT=600
COOLDOWN_SECONDS=60
# Необязательный импорт документированного CSV SpiderFoot. Автоскан отключён.
SPIDERFOOT_CSV_EXPORT=
# Пути нужны только для технической проверки CLI через main.py --check.
SPIDERFOOT_PATH=
SPIDERFOOT_PYTHON=
# Только ваши разрешённые ники, через запятую; сравнение регистрозависимое.
SPIDERFOOT_ALLOWED_USERNAMES=
